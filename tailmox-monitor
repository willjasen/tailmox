DEFAULT_INTERVAL_SECONDS = 60
ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")
PEER_HEADING = re.compile(r"^\s*-\s+(.+?)\s+\(([^)]+)\)\s*$")
TAILSCALE_PATH = re.compile(
    r"Tailscale path(?: check failed)?:\s+(?P<received>\d+)\s+of\s+"
    r"(?P<sent>\d+)\s+Tailscale pings succeeded"
    r"(?:.*?average latency (?P<average>[0-9.]+|unknown) ms;"
    r"\s+maximum latency (?P<maximum>[0-9.]+|unknown) ms)?"
)
ICMP_RESULT = re.compile(
    r"(?P<size>\d+)-byte ICMP:.*?average latency "
    r"(?P<average>[0-9.]+|unknown) ms; maximum latency "
    r"(?P<maximum>[0-9.]+|unknown) ms;(?P<remainder>.*)"
)
ICMP_UNPARSEABLE_RESULT = re.compile(
    r"(?P<size>\d+)-byte ICMP:\s+"
    r"(?P<detail>(?:latency )?result could not be interpreted\..*)"
)
ICMP_REPLIES = re.compile(r"(?:only\s+)?(\d+)\s+of\s+(\d+)\s+replies")
TCP_RESULT = re.compile(
    r"^\s*-\s+TCP port\s+(?P<port>\d+)\s+is\s+(?P<unavailable>not\s+)?available"
    r"(?:;\s+latency\s+(?P<latency>[0-9.]+)\s+ms)?\.\s*$"
)
MONITOR_ICMP_RESULT = re.compile(
    r"^__TAILMOX_MONITOR_ICMP__\t(?P<hostname>[^\t]+)\t"
    r"(?P<size>\d+)\t(?P<status>passed|warning|failed)\t"
    r"(?P<received>\d+|unknown)\t(?P<sent>\d+|unknown)\t"
    r"(?P<average>[0-9.]+|unknown)\t(?P<maximum>[0-9.]+|unknown)$"
)

