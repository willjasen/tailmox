#!/usr/bin/env bash

set -Eeuo pipefail

TAILMOX_WEB_LAUNCHER_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
TAILMOX_COMMAND="${TAILMOX_COMMAND:-$TAILMOX_WEB_LAUNCHER_DIR/tailmox}"
TAILMOX_WEB_ACTION="${1:-}"

if [[ "$#" -gt 1 ]]; then
    printf 'The Tailmox web terminal accepts only one action.\n' >&2
    exit 2
fi

case "$TAILMOX_WEB_ACTION" in
    "")
        printf '%s\n' \
            'Tailmox command output is ready.' \
            'Choose an action above to run an approved Tailmox command.' \
            'This view is read-only and does not provide a host shell.' \
            ''
        while true; do
            sleep 3600
        done
        ;;
    test)
        exec "$TAILMOX_COMMAND" test
        ;;
    backup-create)
        exec "$TAILMOX_COMMAND" backups create
        ;;
    cluster)
        exec "$TAILMOX_COMMAND" cluster
        ;;
    *)
        printf 'Unsupported Tailmox web action: %s\n' "$TAILMOX_WEB_ACTION" >&2
        exit 2
        ;;
esac
