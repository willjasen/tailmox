#!/usr/bin/env bash

set -Eeuo pipefail

TAILMOX_COMMAND=${BASH_SOURCE[0]}
if [[ "$TAILMOX_COMMAND" != /* ]]; then
    TAILMOX_COMMAND="$(pwd)/$TAILMOX_COMMAND"
fi
while [[ -L "$TAILMOX_COMMAND" ]]; do
    TAILMOX_COMMAND_DIR=$(cd "$(dirname "$TAILMOX_COMMAND")" && pwd)
    TAILMOX_COMMAND=$(readlink "$TAILMOX_COMMAND")
    if [[ "$TAILMOX_COMMAND" != /* ]]; then
        TAILMOX_COMMAND="$TAILMOX_COMMAND_DIR/$TAILMOX_COMMAND"
    fi
done
TAILMOX_ROOT=$(cd "$(dirname "$TAILMOX_COMMAND")" && pwd)
TAILMOX_COMMAND="$TAILMOX_ROOT/$(basename "$TAILMOX_COMMAND")"

bootstrap_command() {
    local bin_dir="${TAILMOX_BIN_DIR:-/usr/local/bin}"
    local command_link="$bin_dir/tailmox"

    # Project development does not require a global installation. Production
    # setup runs as root; tests can opt into a temporary bin directory.
    if [[ -z "${TAILMOX_BIN_DIR:-}" && "$EUID" -ne 0 ]]; then
        return 0
    fi

    if [[ -e "$command_link" && ! -L "$command_link" ]]; then
        printf 'Cannot install tailmox: %s already exists and is not a symbolic link.\n' \
            "$command_link" >&2
        return 1
    fi

    if ! mkdir -p "$bin_dir" || ! ln -sfn "$TAILMOX_COMMAND" "$command_link"; then
        printf 'Unable to install the tailmox command at %s.\n' "$command_link" >&2
        return 1
    fi
}

run_self_tests() {
    local test_file
    local passed=0
    local -a test_files=()

    while IFS= read -r test_file; do
        test_files+=("$test_file")
    done < <(find "$TAILMOX_ROOT/tests" -maxdepth 1 -type f -name 'test-*.sh' | sort)

    if [[ "${#test_files[@]}" -eq 0 ]]; then
        printf 'No tests found.\n' >&2
        return 1
    fi

    for test_file in "${test_files[@]}"; do
        printf '\n==> %s\n' "${test_file#"$TAILMOX_ROOT/"}"
        bash "$test_file"
        passed=$((passed + 1))
    done

    printf '\nAll %d test files passed.\n' "$passed"
}

install_monitor_service() {
    local systemd_dir="${TAILMOX_SYSTEMD_DIR:-/etc/systemd/system}"
    local service_name="${TAILMOX_MONITOR_SERVICE:-tailmox-monitor.service}"
    local service_source="$TAILMOX_ROOT/tailmox-monitor.service"
    local service_target="$systemd_dir/$service_name"

    if [[ ! -f "$service_source" ]]; then
        printf 'Missing monitor service definition: %s\n' "$service_source" >&2
        return 1
    fi
    if [[ -e "$service_target" ]] &&
        { ! grep -Fqx 'Description=Tailmox health monitor' "$service_target" ||
          ! grep -Fq '/tailmox monitor ' "$service_target"; }; then
        printf 'Refusing to replace unrelated service: %s\n' "$service_target" >&2
        return 1
    fi
    if ! install -d -m 0755 "$systemd_dir" ||
        ! install -m 0644 "$service_source" "$service_target"; then
        printf 'Unable to install %s.\n' "$service_target" >&2
        return 1
    fi
    if ! systemctl daemon-reload ||
        ! systemctl enable "$service_name" ||
        ! systemctl restart "$service_name"; then
        printf 'Unable to enable and start %s.\n' "$service_name" >&2
        return 1
    fi

    printf 'Tailmox monitor installed and running once per minute.\n'
}

restart_monitor_service() {
    local systemd_dir="${TAILMOX_SYSTEMD_DIR:-/etc/systemd/system}"
    local service_name="${TAILMOX_MONITOR_SERVICE:-tailmox-monitor.service}"
    local service_target="$systemd_dir/$service_name"

    if [[ ! -e "$service_target" ]]; then
        printf 'Tailmox monitor is not installed.\n' >&2
        return 1
    fi
    if ! grep -Fqx 'Description=Tailmox health monitor' "$service_target" ||
        ! grep -Fq '/tailmox monitor ' "$service_target"; then
        printf 'Refusing to restart unrelated service: %s\n' "$service_target" >&2
        return 1
    fi
    if ! systemctl restart "$service_name"; then
        printf 'Unable to restart %s.\n' "$service_name" >&2
        return 1
    fi

    printf 'Tailmox monitor restarted. Monitoring history was preserved.\n'
}

uninstall_monitor_service() {
    local systemd_dir="${TAILMOX_SYSTEMD_DIR:-/etc/systemd/system}"
    local service_name="${TAILMOX_MONITOR_SERVICE:-tailmox-monitor.service}"
    local service_target="$systemd_dir/$service_name"

    if [[ ! -e "$service_target" ]]; then
        printf 'Tailmox monitor is not installed. Monitoring history was preserved.\n'
        return 0
    fi
    if [[ -e "$service_target" ]] &&
        { ! grep -Fqx 'Description=Tailmox health monitor' "$service_target" ||
          ! grep -Fq '/tailmox monitor ' "$service_target"; }; then
        printf 'Refusing to remove unrelated service: %s\n' "$service_target" >&2
        return 1
    fi
    if ! systemctl disable --now "$service_name"; then
        printf 'Unable to stop and disable %s; it was not removed.\n' \
            "$service_name" >&2
        return 1
    fi
    if [[ -e "$service_target" ]] && ! rm -f "$service_target"; then
        printf 'Unable to remove %s.\n' "$service_target" >&2
        return 1
    fi
    if ! systemctl daemon-reload; then
        printf 'The service was removed, but systemd could not be reloaded.\n' >&2
        return 1
    fi

    printf 'Tailmox monitor uninstalled. Monitoring history was preserved.\n'
}

show_usage() {
    local blue=$'\033[94m'
    local reset=$'\033[0m'
    local word_break='⁠'

    printf '%s\n' \
 'Usage:' \
 "  tailmox ${blue}cluster${reset} [options]  Run the complete clustering workflow" \
 "  tailmox ${blue}in${word_break}fo${reset}               Show current Tailmox cluster information" \
 "  tailmox ${blue}serve${reset} [subcommand]" \
 "      ${blue}start${reset} [options]          Start the dashboard and read-only command output (default)" \
 "      ${blue}stop${reset}                     Stop the dashboard and command-output service" \
 "      ${blue}restart${reset}                  Stop and restart the dashboard and command-output service" \
 "  tailmox ${blue}stage${reset} [options]    Set up Tailscale and certificates only" \
 "  tailmox ${blue}backups${reset} [list]     List Tailmox configuration backups" \
 "      ${blue}create${reset}                   Create a configuration backup now" \
 "  tailmox ${blue}test${reset}               Safely test setup without changing the host" \
 "  tailmox ${blue}monitor${reset} [options]  Record test analytics every minute" \
 "      ${blue}install${reset}                  Install and start the background monitor" \
 "      ${blue}restart${reset}                  Restart the installed background monitor" \
 "      ${blue}uninstall${reset}                Stop and remove the background monitor" \
 "  tailmox ${blue}self-test${reset}          Run the regression test suite" \
 "  tailmox ${blue}help${reset}               Show this help" \
 '' \
 'Options such as --auth-key are passed through to tailmox.sh.'
}

if [[ "${1:-}" != "info" ]]; then
    bootstrap_command
fi

case "${1:-}" in
    info)
        shift
        if [[ "$#" -ne 0 ]]; then
            printf 'tailmox info does not accept arguments.\n' >&2
            exit 2
        fi
        exec "$TAILMOX_ROOT/tailmox.sh" info
        ;;
    cluster)
        shift
        exec "$TAILMOX_ROOT/tailmox.sh" --terminal "$@"
        ;;
    serve)
        shift
        case "${1:-}" in
            start)
                shift
                exec "$TAILMOX_ROOT/tailmox.sh" "$@"
                ;;
            ""|-*)
                exec "$TAILMOX_ROOT/tailmox.sh" "$@"
                ;;
            stop)
                shift
                if [[ "$#" -ne 0 ]]; then
                    printf 'tailmox serve stop does not accept arguments.\n' >&2
                    exit 2
                fi
                exec "$TAILMOX_ROOT/tailmox.sh" --web-stop
                ;;
            restart)
                shift
                if [[ "$#" -ne 0 ]]; then
                    printf 'tailmox serve restart does not accept arguments.\n' >&2
                    exit 2
                fi
                "$TAILMOX_ROOT/tailmox.sh" --web-stop
                restart_status=$?
                if [[ "$restart_status" -ne 0 ]]; then
                    exit "$restart_status"
                fi
                exec "$TAILMOX_ROOT/tailmox.sh"
                ;;
            *)
                if [[ -n "${1:-}" ]]; then
                    printf 'Unknown serve action: %s\n' "$1" >&2
                fi
                printf 'Usage: tailmox serve [start|stop|restart]\n' >&2
                exit 2
                ;;
        esac
        ;;
    stage)
        shift
        exec "$TAILMOX_ROOT/tailmox.sh" --terminal --staging "$@"
        ;;
    backups)
        shift
        case "${1:-list}" in
            list)
                if [[ "$#" -gt 0 ]]; then
                    shift
                fi
                if [[ "$#" -ne 0 ]]; then
                    printf 'tailmox backups list does not accept arguments.\n' >&2
                    exit 2
                fi
                exec "$TAILMOX_ROOT/tailmox.sh" --backups-list
                ;;
            create)
                shift
                if [[ "$#" -ne 0 ]]; then
                    printf 'tailmox backups create does not accept arguments.\n' >&2
                    exit 2
                fi
                exec "$TAILMOX_ROOT/tailmox.sh" --backup-create
                ;;
            *)
                printf 'Unknown backups action: %s\n' "$1" >&2
                printf 'Usage: tailmox backups [list|create]\n' >&2
                exit 2
                ;;
        esac
        ;;
    test)
        shift
        if [[ "$#" -ne 0 ]]; then
            printf 'tailmox test does not accept arguments.\n' >&2
            exit 2
        fi
        exec "$TAILMOX_ROOT/tailmox.sh" --dry-run
        ;;
    monitor)
        shift
        case "${1:-}" in
            install)
                shift
                if [[ "$#" -ne 0 ]]; then
                    printf 'tailmox monitor install does not accept arguments.\n' >&2
                    exit 2
                fi
                install_monitor_service
                ;;
            restart)
                shift
                if [[ "$#" -ne 0 ]]; then
                    printf 'tailmox monitor restart does not accept arguments.\n' >&2
                    exit 2
                fi
                restart_monitor_service
                ;;
            uninstall)
                shift
                if [[ "$#" -ne 0 ]]; then
                    printf 'tailmox monitor uninstall does not accept arguments.\n' >&2
                    exit 2
                fi
                uninstall_monitor_service
                ;;
            *)
                exec "$TAILMOX_ROOT/tailmox-monitor" "$@"
                ;;
        esac
        ;;
    self-test)
        shift
        if [[ "$#" -ne 0 ]]; then
            printf 'tailmox self-test does not accept arguments.\n' >&2
            exit 2
        fi
        run_self_tests
        ;;
    ""|help|-h|--help)
        show_usage
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$1" >&2
        show_usage >&2
        exit 2
        ;;
esac
